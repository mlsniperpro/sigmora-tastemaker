+  it("caps the picks, and searches nothing once the labelled lines fill the cap", async () => {
+    const many = `Collab targets: ${Array.from({ length: 20 }, (_, i) => `Artist Number${String.fromCharCode(65 + i)}`).join(", ")}\nShout out to Burna Boy.`;
+    const q = offline();
+    let calls = 0;
