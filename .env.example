# Everything is optional: with no variables set the app runs fully offline
# (simulated Qloo responses + a scripted model) and labels itself as such.
# Every value is validated at startup (src/lib/config.ts).

# --- Qloo (the hackathon key works only on hackathon.api.qloo.com) ---
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# auto = live when a key is set; a failed live call falls back to a recorded
#        live response (fixtures/qloo) if one exists, otherwise the error shows;
#        without a key: recorded responses, then the labeled offline simulator
# live = live only (errors surface); replay = never call the API
# QLOO_MODE=auto
# Live Qloo calls per run (cache hits are free). With the scripted model the presets make 60–76 (`pnpm demo` prints the count);
# a real model that invents more names makes more.
# QLOO_RUN_CALL_CAP=90
# Live Qloo calls per UTC day across all users (shared when KV is set). Qloo doesn't publish the hackathon key's quota:
# ask for the judging-period quota and set this to about quota ÷ 15 days.
# QLOO_DAILY_CALL_CAP=480
# A new live run first reserves QLOO_RUN_ESTIMATE calls in one atomic step (unspent calls go back), so concurrent runs
# can't all start and then run dry; when it can't, it is refused up front and presets serve their recording or last run.
# QLOO_RUN_ESTIMATE=80
# The day is split into two pools so neither kind of run can starve the other: cold preset runs draw on QLOO_PRESET_POOL
# (each preset at most QLOO_PRESET_DAILY_CALLS), custom briefs and "Re-run live" on the rest (each network, i.e. IP or
# IPv6 /64, at most QLOO_IP_DAILY_CALLS, which may be at most a third of the custom pool). Settings that can't fit one run
# (or one plan audit, which reserves 30 and spends at most 80) in every share fail the build.
# QLOO_PRESET_POOL=240
# QLOO_PRESET_DAILY_CALLS=160
# QLOO_IP_DAILY_CALLS=80
# Requests per second to the Qloo host (reported limit: 5).
# QLOO_RPS=4
# QLOO_TIMEOUT_MS=12000
# bias.trends on candidate discovery for artists, TV, movies and podcasts: off | low | medium | high
# QLOO_BIAS_TRENDS=medium

# --- LLM (any vendor) ---
# LLM_PROVIDER = openai | anthropic | openai-compatible | deterministic
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# For OpenAI-compatible hosts (OpenRouter, Groq, Together, vLLM, Ollama, …)
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=25000

# --- Benchmark judge (pnpm benchmark). Falls back to LLM_* when unset. ---
# Prefer a different model from the generator, to avoid self-preference.
# JUDGE_PROVIDER=
# JUDGE_MODEL=
# JUDGE_API_KEY=
# JUDGE_BASE_URL=

# --- Sigmora publisher (sandbox for everyone unless all four are set) ---
# SIGMORA_PUBLISH_MODE=live
# SIGMORA_API_URL=
# SIGMORA_API_TOKEN=
# Only requests carrying this key (header x-tastemaker-owner, or the cookie POST /api/owner sets) reach real channels.
# SIGMORA_OWNER_KEY=

# --- Shared cache and counters (Upstash / Vercel KV REST) ---
# Without these, cache and rate-limit counters are per server instance.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Abuse and budget guard (applies only to runs that cost money) ---
# RATE_LIMIT_PER_MINUTE=4
# New runs per IP per UTC day ("Re-run live" on a preset counts, as do audits that call live Qloo or a model; one-click presets don't).
# RATE_LIMIT_PER_DAY=20
# RUN_DAILY_CAP=150

# --- MCP: browser origins allowed to call /api/mcp cross-origin ---
# MCP_ALLOWED_ORIGINS=https://example.com,https://other.example
